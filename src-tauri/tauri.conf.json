{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraeJumper",
  "version": "0.9.10",
  "identifier": "com.marscey.traejumper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TraeJumper",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMDJENDY2QjBDRUY1QUIKUldTcjljNndadFFDOFFPYVoraGdMK3BpczFKTGg5R1l5aEczMnZSck1XVDJ4eDZGaUhVZ09pZzIK",
      "endpoints": [
        "https://github.com/marscey/trae-jumper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
